# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Gmail Configuration (per n8n)
GMAIL_USER=your-email@gmail.com

# n8n Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/upload-excel

# DLP Configuration
DLP_MASKING_CHARACTER=*
DLP_MIN_LIKELIHOOD=POSSIBLE
# LIKELIHOOD OPTIONS: VERY_UNLIKELY, UNLIKELY, POSSIBLE, LIKELY, VERY_LIKELY

# Email Configuration
EMAIL_SENDER=your-email@gmail.com
EMAIL_SUBJECT=File Excel Anonimizzato - Pronto per il Download
